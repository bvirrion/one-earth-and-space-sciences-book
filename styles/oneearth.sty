% ----------------------------------------------------------------------------
% Block diagrams and the celestial sphere.
%
% pic {blockdiagram={<width>}{<height>}{<depth>}}: an oblique prism (depth
% receding at 30 degrees, foreshortened by half), origin at the front bottom
% left. Named coordinates for filling faces: -fbl -fbr -ftl -ftr (front),
% -bbl -bbr -btl -btr (back). The faces are drawn last by the figure itself.
%
% pic {celestialsphere={<latitude in degrees>}}: the local sky as a sphere of
% radius 2 cm around the observer, in true orthographic projection, seen from
% the WEST and from 17.5 degrees above the horizon (the horizon's ellipse has a
% minor axis of 0.3 R). North is to the LEFT, south to the right, east away
% from the reader. Drawn: the sphere's outline, the horizon and the celestial
% equator (front halves solid, back halves dashed), the polar axis. Named
% coordinates: -O (observer), -Z (zenith), -N, -S, -W (front), -E (back) on
% the horizon, -NCP and -SCP (the celestial poles, the north one at an
% altitude equal to the latitude). Labels are the figure's.
% ----------------------------------------------------------------------------
\tikzset{
  pics/blockdiagram/.style n args={3}{code={
    \pgfmathsetmacro{\om@dx}{0.5*(#3)*cos(30)}\pgfmathsetmacro{\om@dy}{0.5*(#3)*sin(30)}
    \coordinate (-fbl) at (0,0);   \coordinate (-fbr) at (#1,0);
    \coordinate (-ftl) at (0,#2);  \coordinate (-ftr) at (#1,#2);
    \coordinate (-bbl) at (\om@dx,\om@dy);   \coordinate (-bbr) at ({#1+\om@dx},\om@dy);
    \coordinate (-btl) at (\om@dx,{#2+\om@dy});  \coordinate (-btr) at ({#1+\om@dx},{#2+\om@dy});
  }},
  pics/celestialsphere/.style={code={
    \def\om@R{2}\def\om@se{0.3}\def\om@ce{0.9539}
    \coordinate (-O) at (0,0);
    \coordinate (-Z) at (0,{\om@R*\om@ce});
    \coordinate (-N) at (-\om@R,0);
    \coordinate (-S) at (\om@R,0);
    \coordinate (-W) at (0,{-\om@R*\om@se});
    \coordinate (-E) at (0,{\om@R*\om@se});
    \coordinate (-NCP) at ({-\om@R*cos(#1)},{\om@R*sin(#1)*\om@ce});
    \coordinate (-SCP) at ({\om@R*cos(#1)},{-\om@R*sin(#1)*\om@ce});
    \draw[black, line width=0.6pt] (0,0) circle (\om@R);
    \draw[black!70, line width=0.5pt, dashed] plot[domain=0:180, samples=61, smooth, variable=\t]
      ({\om@R*cos(\t)},{\om@R*sin(\t)*\om@se});
    \draw[black!70, line width=0.6pt] plot[domain=180:360, samples=61, smooth, variable=\t]
      ({\om@R*cos(\t)},{\om@R*sin(\t)*\om@se});
    \draw[omDef, line width=0.5pt, dashed] plot[domain=0:180, samples=61, smooth, variable=\t]
      ({\om@R*cos(\t)*sin(#1)},{\om@R*(sin(\t)*\om@se+cos(\t)*cos(#1)*\om@ce)});
    \draw[omDef, line width=0.6pt] plot[domain=180:360, samples=61, smooth, variable=\t]
      ({\om@R*cos(\t)*sin(#1)},{\om@R*(sin(\t)*\om@se+cos(\t)*cos(#1)*\om@ce)});
    \draw[omThm, line width=0.6pt] (-SCP) -- (-NCP);
    \draw[black!60, line width=0.4pt, densely dotted] (0,0) -- (-Z);
    \fill (0,0) circle (0.04);
  }},
}

% ----------------------------------------------------------------------------
% Plot styles. Axis labels are prose and are written in the chapter.
%   omrecord  -- a time series: axes left and bottom, light grid.
%   omage     -- time before present, older to the LEFT (x dir=reverse with
%                Ma or ka on x): \begin{axis}[omrecord, omage] ...
%   omdepth   -- depth downward on y (y dir=reverse): geotherms, profiles,
%                PREM, soundings.
%   ommap     -- longitude/latitude axes in degrees with a 1:1 aspect
%                (equirectangular); data from figdata/shared/geo.py.
%   omsection -- a cross-section: distance on x, elevation on y, the axes
%                left and bottom; state the vertical exaggeration with \omve{N}.
%   ompt      -- pressure-temperature grid (T on x, P or depth on y).
% Tick labels print thousands with a thin space (1 000), never a comma.
% ----------------------------------------------------------------------------
\pgfplotsset{/pgf/number format/1000 sep={\,}}
\pgfplotsset{
  omrecord/.style={axis x line=bottom, axis y line=left, axis line style={-}, grid=major,
    grid style={gray!22, line width=0.3pt},
    every axis label/.append style={font=\small},
    tick label style={font=\small}, legend style={font=\footnotesize}},
  omage/.style={x dir=reverse},
  omdepth/.style={y dir=reverse},
  ommap/.style={axis equal image, xmin=-180, xmax=180, ymin=-90, ymax=90,
    xtick={-180,-120,...,180}, ytick={-90,-60,...,90},
    tick label style={font=\scriptsize},
    xticklabel={$\pgfmathprintnumber{\tick}^\circ$},
    yticklabel={$\pgfmathprintnumber{\tick}^\circ$},
    grid=major, grid style={gray!25, line width=0.25pt},
    axis background/.style={fill=omSea}},
  omsection/.style={axis x line=bottom, axis y line=left, axis line style={-}, clip=false,
    every axis label/.append style={font=\small}, tick label style={font=\small}},
  ompt/.style={axis x line=bottom, axis y line=left, axis line style={-}, grid=major,
    grid style={gray!22, line width=0.3pt},
    every axis label/.append style={font=\small}, tick label style={font=\small}},
}
% Arabic: the label is set right to left and the factor printed mirrored
% ("260\times"). Inside a TikZ node \babelsublr does NOT restore the order
% (probe, 2026-10-25: prose was fixed, nodes were not); an explicit LR box is
% needed, and it works in both places (Earth Book 1 ar agent's report).
\newcommand{\omve}[1]{{\footnotesize\itshape\omnameVE~%
  \ifom@arabic\mbox{\textdir TLT$\times#1$}\else$\times#1$\fi}}

% amsthm's proof environment prints \proofname, which is English unless babel
% localises it — and babel is optional here (see above). Without this, a French
% chapter opens every proof with "Proof." instead of "Démonstration.".
\renewcommand{\proofname}{\omnameProof}

% Results stated without proof
\newcommand{\admitted}{\begin{proof}[\omnameProof]\emph{\omadmittedtext}\end{proof}}

% cleveref names. Every referenceable environment needs one: cleveref's built-in
% names are English, and babel (which would localise them) is optional here — so
% without these a French book reads "d'apres le Theorem 3.1" and "Chapter 5" in
% the middle of its French prose. The names come from styles/lang/<lang>.tex, so
% English output is unchanged and each translation gets its own.
\crefname{definition}{\omnameDefinition}{\omnameDefinitions}
\Crefname{definition}{\omnameDefinition}{\omnameDefinitions}
\crefname{theorem}{\omnameTheorem}{\omnameTheorems}
\Crefname{theorem}{\omnameTheorem}{\omnameTheorems}
\crefname{proposition}{\omnameProposition}{\omnamePropositions}
\Crefname{proposition}{\omnameProposition}{\omnamePropositions}
\crefname{lemma}{\omnameLemma}{\omnameLemmas}
\Crefname{lemma}{\omnameLemma}{\omnameLemmas}
\crefname{corollary}{\omnameCorollary}{\omnameCorollarys}
\Crefname{corollary}{\omnameCorollary}{\omnameCorollarys}
\crefname{method}{\omnameMethod}{\omnameMethods}
\Crefname{method}{\omnameMethod}{\omnameMethods}
\crefname{example}{\omnameExample}{\omnameExamples}
\Crefname{example}{\omnameExample}{\omnameExamples}
\crefname{notation}{\omnameNotation}{\omnameNotations}
\Crefname{notation}{\omnameNotation}{\omnameNotations}
\crefname{remark}{\omnameRemark}{\omnameRemarks}
