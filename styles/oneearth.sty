% Compass rose: pic {compassrose}, radius 1 (scale with the scope); four long
% points N, E, S, W with labels, four short diagonal points. Each point is
% half black, half white so the rose reads under any rotation. Labels are
% nodes: with transform shape they scale with the rose.
\tikzset{pics/compassrose/.style={code={
  % The letters are language strings (styles/lang/<lang>.tex): a French rose
  % reads N E S O.
  \foreach \om@a/\om@l in {90/\omnameCompassN,0/\omnameCompassE,270/\omnameCompassS,180/\omnameCompassW} {
    \fill[black] (0,0) -- (\om@a:1) -- (\om@a+45:0.2) -- cycle;
    \draw[black, line width=0.4pt, fill=white] (0,0) -- (\om@a:1) -- (\om@a-45:0.2) -- cycle;
    \node[font=\small\bfseries, inner sep=1pt] at (\om@a:1.22) {\om@l};
  }
  \foreach \om@a in {45,135,225,315} {
    \fill[black!70] (0,0) -- (\om@a:0.55) -- (\om@a+45:0.12) -- cycle;
    \draw[black, line width=0.3pt, fill=white] (0,0) -- (\om@a:0.55) -- (\om@a-45:0.12) -- cycle;
  }
  \draw[black, line width=0.4pt, fill=white] (0,0) circle (0.06);
}}}

