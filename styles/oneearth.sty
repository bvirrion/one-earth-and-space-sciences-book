% Weather icons: pic {omwx=<name>} draws a 1 x 1 icon centred on the origin
% (scale it with the scope); \omwx[<scale>]{<name>} sets it inline, about one
% line high. Names: sun, suncloud, cloud, rain, shower, snow, storm, fog, wind.
% pic {puffycloud} is a 2 x 1 fair-weather cloud with a flat base, origin at
% the middle of its base, for scenes and diagrams.
\definecolor{omWxSun}{HTML}{F5B700}
\definecolor{omWxCloud}{HTML}{F4F6F8}
\definecolor{omWxDark}{HTML}{9AA3AE}
\definecolor{omWxRain}{HTML}{2E7BC4}
\definecolor{omWxBolt}{HTML}{F2C200}
\newcommand{\om@wxshapes}[1]{% one path per shape: overlapping subpaths of
  % opposite orientation would leave holes under the nonzero rule
  #1 (-0.34,-0.12) rectangle (0.36,0.0);
  #1 (-0.20,0.02) circle (0.15); #1 (0.06,0.10) circle (0.20);
  #1 (0.26,0.00) circle (0.12); #1 (-0.34,-0.03) circle (0.09);
  #1 (0.36,-0.03) circle (0.09);}
\newcommand{\om@wxcloud}[3]{% #1 dx, #2 dy, #3 fill
  \begin{scope}[shift={(#1,#2)}]
    \om@wxshapes{\draw[black!60, line width=0.8pt]}%
    \om@wxshapes{\fill[#3]}%
  \end{scope}}
\newcommand{\om@wxsun}[3]{% #1 dx, #2 dy, #3 radius
  \begin{scope}[shift={(#1,#2)}]
    \foreach \om@r in {0,45,...,315}
      \draw[omWxSun, line width=0.8pt, line cap=round]
        (\om@r:{1.35*#3}) -- (\om@r:{1.85*#3});
    \fill[omWxSun] (0,0) circle (#3);
  \end{scope}}
\newcommand{\om@wxdrops}{%
  \foreach \om@x in {-0.18,0.02,0.22}
    \draw[omWxRain, line width=0.9pt, line cap=round]
      (\om@x,-0.22) -- ++(-0.07,-0.20);}
\tikzset{
  pics/omwx/.style={code={\csname om@wx@#1\endcsname}},
  pics/puffycloud/.style={code={
    \begin{scope}[scale=2.6, shift={(0,0.12)}]\om@wxcloud{0}{0}{white}\end{scope}
  }},
}
\newcommand{\om@wx@sun}{\om@wxsun{0}{0}{0.2}}
\newcommand{\om@wx@cloud}{\om@wxcloud{0}{0.02}{omWxCloud}}
\newcommand{\om@wx@suncloud}{\om@wxsun{-0.16}{0.16}{0.15}\om@wxcloud{0.08}{-0.08}{omWxCloud}}
\newcommand{\om@wx@rain}{\om@wxcloud{0}{0.14}{omWxDark!45}\om@wxdrops}
\newcommand{\om@wx@shower}{\om@wxsun{-0.2}{0.26}{0.12}\om@wxcloud{0.04}{0.12}{omWxCloud}\om@wxdrops}
\newcommand{\om@wx@snow}{\om@wxcloud{0}{0.14}{omWxCloud}%
  \foreach \om@x/\om@y in {-0.2/-0.27,0.02/-0.37,0.24/-0.27}
    \foreach \om@a in {0,60,120}
      \draw[omWxRain, line width=0.6pt] (\om@x,\om@y) ++(\om@a:0.07) -- ++(\om@a+180:0.14);}
\newcommand{\om@wx@storm}{\om@wxcloud{0}{0.14}{omWxDark!80}%
  \fill[omWxBolt, draw=black!60, line width=0.3pt, line join=round]
    (0.06,-0.04) -- (-0.08,-0.24) -- (0.0,-0.24) -- (-0.08,-0.44)
    -- (0.12,-0.18) -- (0.03,-0.18) -- (0.12,-0.04) -- cycle;}
\newcommand{\om@wx@fog}{%
  \foreach \om@y/\om@a/\om@b in {0.24/-0.34/0.3, 0.08/-0.4/0.4, -0.08/-0.3/0.36, -0.24/-0.38/0.24}
    \draw[omWxDark, line width=1.4pt, line cap=round] (\om@a,\om@y) -- (\om@b,\om@y);}
\newcommand{\om@wx@wind}{%
  \draw[omWxDark!120, line width=1pt, line cap=round]
    (-0.4,0.18) -- (0.2,0.18) arc[start angle=-90, end angle=180, radius=0.1]
    (-0.4,0.0) -- (0.32,0.0) arc[start angle=90, end angle=-180, radius=0.1]
    (-0.4,-0.18) -- (0.05,-0.18);}
\newcommand{\omwx}[2][1]{%
  \pgfmathsetmacro{\om@wxscale}{0.5*(#1)}%
