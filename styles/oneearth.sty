% Lithologies: one TikZ style per rock, a pale fill under a black ornament,
% for sections, columns, block diagrams and map legends:
%   \fill[lith limestone] (0,0) rectangle (4,1);   \draw[lith shale] ...;
%   \omlith{limestone}  -- a small legend swatch, on the text baseline.
% Names: sandstone, shale, limestone, dolomite, conglomerate, evaporite, coal,
% granite, basalt, gneiss, schist, alluvium, sea (water), ice.
% The ornaments are uncolored patterns.meta tiles (pattern color sets the ink).
% ----------------------------------------------------------------------------
\tikzdeclarepattern{name=om sand, type=uncolored,
  bounding box={(0,0) and (3mm,3mm)}, tile size={(3mm,3mm)},
  code={\pgfpathcircle{\pgfpoint{0.6mm}{0.7mm}}{0.18mm}
        \pgfpathcircle{\pgfpoint{2.1mm}{1.3mm}}{0.18mm}
        \pgfpathcircle{\pgfpoint{1.2mm}{2.4mm}}{0.18mm}
        \pgfusepath{fill}}}
\tikzdeclarepattern{name=om shale, type=uncolored,
  bounding box={(0,0) and (4mm,1.6mm)}, tile size={(4mm,1.6mm)},
  code={\pgfsetlinewidth{0.3pt}
        \pgfpathmoveto{\pgfpoint{0.3mm}{0.4mm}}\pgfpathlineto{\pgfpoint{1.7mm}{0.4mm}}
        \pgfpathmoveto{\pgfpoint{2.3mm}{1.2mm}}\pgfpathlineto{\pgfpoint{3.7mm}{1.2mm}}
        \pgfusepath{stroke}}}
\tikzdeclarepattern{name=om limestone, type=uncolored,
  bounding box={(0,0) and (4mm,2.4mm)}, tile size={(4mm,2.4mm)},
  code={\pgfsetlinewidth{0.3pt}
        \pgfpathmoveto{\pgfpoint{0mm}{0mm}}\pgfpathlineto{\pgfpoint{4mm}{0mm}}
        \pgfpathmoveto{\pgfpoint{0mm}{1.2mm}}\pgfpathlineto{\pgfpoint{4mm}{1.2mm}}
        \pgfpathmoveto{\pgfpoint{1mm}{0mm}}\pgfpathlineto{\pgfpoint{1mm}{1.2mm}}
        \pgfpathmoveto{\pgfpoint{3mm}{1.2mm}}\pgfpathlineto{\pgfpoint{3mm}{2.4mm}}
        \pgfusepath{stroke}}}
\tikzdeclarepattern{name=om dolomite, type=uncolored,
  bounding box={(0,0) and (4mm,2.4mm)}, tile size={(4mm,2.4mm)},
  code={\pgfsetlinewidth{0.3pt}
        \pgfpathmoveto{\pgfpoint{0mm}{0mm}}\pgfpathlineto{\pgfpoint{4mm}{0mm}}
        \pgfpathmoveto{\pgfpoint{0mm}{1.2mm}}\pgfpathlineto{\pgfpoint{4mm}{1.2mm}}
        \pgfpathmoveto{\pgfpoint{0.7mm}{0mm}}\pgfpathlineto{\pgfpoint{1.3mm}{1.2mm}}
        \pgfpathmoveto{\pgfpoint{2.7mm}{1.2mm}}\pgfpathlineto{\pgfpoint{3.3mm}{2.4mm}}
        \pgfusepath{stroke}}}
\tikzdeclarepattern{name=om conglomerate, type=uncolored,
  bounding box={(0,0) and (5mm,4mm)}, tile size={(5mm,4mm)},
  code={\pgfsetlinewidth{0.3pt}
