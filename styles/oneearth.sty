% Wind barb (station model): pic {windbarb={<speed in knots>}{<direction the
% wind blows FROM, az>}}. The staff points into the wind, 1 cm long; a pennant
% is 50 kn, a full barb 10, a half barb 5 (speed rounded to 5). Barbs are drawn
% on the clockwise side of the staff, the Northern Hemisphere convention; add
% [om barb south] for the Southern Hemisphere. A calm (< 3 kn) is a circle.
\newif\ifom@barbsouth
\tikzset{om barb south/.code={\om@barbsouthtrue}}
\tikzset{pics/windbarb/.style 2 args={code={
  \pgfmathtruncatemacro{\om@s}{5*round((#1)/5)}
  \pgfmathtruncatemacro{\om@pen}{floor(\om@s/50)}
  \pgfmathtruncatemacro{\om@full}{floor((\om@s-50*\om@pen)/10)}
  \pgfmathtruncatemacro{\om@half}{(\om@s-50*\om@pen-10*\om@full)>=5 ? 1 : 0}
  \ifom@barbsouth\def\om@side{-1}\else\def\om@side{1}\fi
  \draw[black, line width=0.4pt] (0,0) circle (0.09);
  \ifnum\om@s<5\relax
    \draw[black, line width=0.4pt] (0,0) circle (0.15);
  \else
  \begin{scope}[rotate={90-(#2)}]
    \draw[black, line width=0.6pt] (0.09,0) -- (1,0);
    \def\om@x{1}
    \ifnum\om@pen>0
      \foreach \om@k in {1,...,\om@pen}{
        \pgfmathsetmacro{\om@xa}{1-0.14*(\om@k-1)}
        \fill[black] (\om@xa,0) -- (\om@xa-0.12,{-\om@side*0.3}) -- (\om@xa-0.12,0) -- cycle;}
    \fi
    \pgfmathsetmacro{\om@x}{1-0.14*\om@pen-(\om@pen>0 ? 0.12 : 0)}% the first barb's tip stays clear of the last pennant
    \ifnum\om@full>0
      \foreach \om@k in {1,...,\om@full}{
        \pgfmathsetmacro{\om@xa}{\om@x-0.1*(\om@k-1)}
        \draw[black, line width=0.6pt] (\om@xa,0) -- (\om@xa+0.1,{-\om@side*0.3});}
    \fi
    \ifnum\om@half>0
      \pgfmathsetmacro{\om@xa}{\om@x-0.1*\om@full-(\om@full+\om@pen>0 ? 0 : 0.1)}
      \draw[black, line width=0.6pt] (\om@xa,0) -- (\om@xa+0.05,{-\om@side*0.15});
    \fi
  \end{scope}
  \fi
}}}

